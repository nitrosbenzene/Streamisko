{
  "rewrites": [
    {
      "source": "/manifest.json",
      "destination": "/api/manifest"
    },
    {
      "source": "/stream/:type/:id.json",
      "destination": "/api/sorted?route=stream&type=:type&id=:id"
    },
    {
      "source": "/",
      "destination": "/api/index?route=home"
    }
  ]
}
